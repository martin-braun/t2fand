"""Foreground fan controller with SMC monitoring and t2fand fail-safe behavior.

The daemon reads and writes sysfs paths by reopening them for every operation.
T2fand-mode temperature or policy failures fail high while fan control remains
available; SMC reports sensor failures as degraded monitoring. Loss of
maximum-speed control is fatal so OpenRC can recover the process.
"""

import argparse
import configparser
import math
import os
import re
import signal
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from statistics import mean
from typing import Callable, Optional, Sequence, TextIO


DEFAULT_CONFIG_PATH = Path("/etc/t2fand.conf")
DEFAULT_PID_PATH = Path("/run/t2fand.pid")
DEFAULT_SYSFS_ROOT = Path("/sys")
SENSOR_RECOVERY_CYCLES = 5
SAMPLE_LIMIT = 10
ERROR_REMINDER_SECONDS = 60.0
CURVES = ("linear", "exponential", "logarithmic")


class DaemonError(Exception):
    """Base class for expected daemon failures."""


class StartupError(DaemonError):
    """A startup precondition or runtime-path operation failed."""


class FatalControlError(DaemonError):
    """The daemon cannot establish or retain maximum fan control."""


@dataclass(frozen=True)
class FanConfig:
    """Validated policy for one fan."""

    low_temp: float
    high_temp: float
    speed_curve: str
    always_full_speed: bool


@dataclass(frozen=True)
class GeneralConfig:
    """Validated global control selection."""

    control_mode: Optional[str]


@dataclass(frozen=True)
class RuntimeSettings:
    """Validated per-process runtime tuning."""

    sensor_recovery_cycles: int = SENSOR_RECOVERY_CYCLES
    sample_limit: int = SAMPLE_LIMIT
    error_reminder_seconds: float = ERROR_REMINDER_SECONDS


@dataclass
class Fan:
    """A fan base path and its discovered integer limits.

    Sysfs files are not opened by this object during construction or retained
    afterwards. A known maximum remains usable for fatal fail-high attempts
    even if another limit is unavailable.
    """

    base_path: Path
    minimum: Optional[int] = None
    maximum: Optional[int] = None

    @property
    def name(self) -> str:
        """Return the stable fan name used in diagnostics."""

        return self.base_path.name

    @property
    def complete(self) -> bool:
        """Whether normal clamped control has both usable limits."""

        return self.minimum is not None and self.maximum is not None

    def _sidecar(self, suffix: str) -> Path:
        return self.base_path.with_name(self.base_path.name + suffix)

    def set_speed(self, speed: int) -> None:
        """Clamp and write a target, reopening the fan output path."""

        if self.maximum is None:
            raise FatalControlError(f"{self.name} has no usable maximum")
        target = min(speed, self.maximum)
        if self.minimum is not None:
            target = max(target, self.minimum)
        self._sidecar("_output").write_text(str(target))

    def enable_manual(self) -> None:
        """Enable manual control by reopening the manual-mode path."""

        self._sidecar("_manual").write_text("1")

    def disable_manual(self) -> None:
        """Best-effort disable of manual control by reopening its path."""

        self._sidecar("_manual").write_text("0")

    def read_manual(self) -> int:
        """Read the current manual-control flag, reopening the input path."""

        return int(self._sidecar("_manual").read_text().strip())

    def read_target_rpm(self) -> int:
        """Read the current fan target, reopening the output path."""

        return int(self._sidecar("_output").read_text().strip())

    def read_actual_rpm(self) -> int:
        """Read one tachometer value, reopening the input path."""

        return int(self._sidecar("_input").read_text().strip())


@dataclass(frozen=True)
class SensorCandidate:
    """One deduplicated temperature path and its topology identities."""

    path: Path
    source: Path
    is_cpu: bool
    is_gpu: bool


@dataclass(frozen=True)
class SensorReading:
    """A parsed temperature, or an unknown value with a diagnostic."""

    label: str
    value: Optional[float]
    is_cpu: bool
    is_gpu: bool
    error: Optional[str] = None


@dataclass(frozen=True)
class SensorSnapshot:
    """All readings and safety facts from one discovery cycle."""

    readings: tuple[SensorReading, ...]
    highest: Optional[float]
    cpu_valid: bool
    gpu_present: bool
    valid: bool
    reason: str
    dgpu_state: str = "unknown"
    highest_label: Optional[str] = None


@dataclass
class ConfigResult:
    """Startup configuration result with mode-specific policy validity."""

    policies: list[Optional[FanConfig]]
    errors: list[str] = field(default_factory=list)
    general: GeneralConfig = field(default_factory=lambda: GeneralConfig("t2fand"))
    warnings: list[str] = field(default_factory=list)
    startup_error: bool = False

    @property
    def valid(self) -> bool:
        """Return whether every detected fan has a validated policy."""

        return not self.errors and self.control_mode in {"smc", "t2fand"} and (
            self.control_mode == "smc"
            or all(policy is not None for policy in self.policies)
        )

    @property
    def control_mode(self) -> Optional[str]:
        """Return the selected global mode."""

        return self.general.control_mode


@dataclass
class ControllerState:
    """Mutable process state kept separate from hardware and configuration."""

    mode: Optional[str] = None
    reason: str = ""
    history: list[float] = field(default_factory=list)
    recovery_history: list[float] = field(default_factory=list)
    recovery_cycles: int = 0
    recovery_active: bool = False
    gpu_present: Optional[bool] = None
    shutdown_requested: bool = False
    last_problem_at: Optional[float] = None
    config_failsafe: bool = False
    config_failure_reason: Optional[str] = None
    control_mode: Optional[str] = None
    control_status: str = ""
    maximum_escalated: bool = False
    sensor_recovery_cycles: int = SENSOR_RECOVERY_CYCLES
    sample_limit: int = SAMPLE_LIMIT
    error_reminder_seconds: float = ERROR_REMINDER_SECONDS


@dataclass(frozen=True)
class CycleReport:
    """Control and telemetry values produced by one cycle."""

    snapshot: SensorSnapshot
    rolling_mean: Optional[float]
    targets: tuple[Optional[int], ...]
    actual_rpm: tuple[Optional[int], ...]
    manual: tuple[Optional[int], ...] = ()


def emit(message: str, error: bool = False, stream: Optional[TextIO] = None) -> None:
    """Print one flushed direct-output diagnostic."""

    destination = stream if stream is not None else (sys.stderr if error else sys.stdout)
    print(message, file=destination, flush=True)


def _read_integer(path: Path) -> int:
    return int(path.read_text().strip())


def _fan_candidates(sysfs_root: Path) -> list[Path]:
    """Find fan input files in the T2 layout."""

    candidates: list[Path] = []
    t2_matches = sorted(
        (sysfs_root / "devices").glob("*/*/*/*/APP0001:00/fan*"), key=str
    )
    for match in t2_matches:
        if match.is_dir():
            candidates.extend(match.glob("fan*_input"))
        elif match.name.startswith("fan") and match.name.endswith("_input"):
            candidates.append(match)
    return sorted(candidates, key=str)


def discover_fans(sysfs_root: Path = DEFAULT_SYSFS_ROOT) -> tuple[list[Fan], list[str]]:
    """Discover fans and read their limits without retaining sysfs handles."""

    bases: dict[str, Path] = {}
    for input_path in _fan_candidates(sysfs_root):
        base = input_path.with_name(input_path.name[: -len("_input")])
        resolved = base.resolve()
        bases.setdefault(str(resolved), resolved)

    fans: list[Fan] = []
    errors: list[str] = []
    for base in bases.values():
        fan = Fan(base)
        for attribute, field_name in (("_min", "minimum"), ("_max", "maximum")):
            try:
                value = _read_integer(fan._sidecar(attribute))
            except (OSError, ValueError, UnicodeError) as exc:
                errors.append(f"{fan.name}{attribute}: unusable fan limit: {exc}")
                continue
            setattr(fan, field_name, value)
        if fan.minimum is not None and fan.maximum is not None:
            if fan.minimum > fan.maximum:
                errors.append(f"{fan.name}: minimum exceeds maximum")
        fans.append(fan)
    if not fans:
        errors.append("no controllable fans discovered")
    elif errors or any(not fan.complete for fan in fans):
        errors.append("no complete controllable fan set")
    return fans, errors


def _drm_card(path: Path) -> Optional[str]:
    for part in path.parts:
        if re.fullmatch(r"card\d+", part):
            return part
    return None


def _switcheroo_state(sysfs_root: Path) -> tuple[Optional[str], str]:
    """Return the powered-off dGPU PCI identity and topology state."""

    switch_path = sysfs_root / "kernel/debug/vgaswitcheroo/switch"
    try:
        lines = switch_path.read_text().splitlines()
    except (OSError, UnicodeError):
        return None, "unknown"

    has_dgpu = False
    for line in lines:
        match = re.match(
            r"^\d+:DIS:[^:]*:(On|Off):(\d{4}:\d{2}:\d{2}\.\d+)$",
            line,
            re.IGNORECASE,
        )
        if match:
            has_dgpu = True
            if match.group(1).lower() == "off":
                return match.group(2), "off"
    return None, "on" if has_dgpu else "unknown"


def _off_dgpu_pci(sysfs_root: Path) -> Optional[str]:
    """Return the powered-off dGPU PCI identity, when switch state is readable."""

    return _switcheroo_state(sysfs_root)[0]


def _sensor_candidates(sysfs_root: Path) -> list[SensorCandidate]:
    """Union global hwmon, coretemp, and exact numeric DRM paths."""

    raw: list[tuple[Path, bool, bool]] = []
    global_paths = sorted(
        (sysfs_root / "class/hwmon").glob("hwmon*/temp*_input"), key=str
    )
    raw.extend((path, False, False) for path in global_paths)
    cpu_paths = sorted(
        (sysfs_root / "devices/platform/coretemp.0/hwmon").glob(
            "hwmon*/temp*_input"
        ),
        key=str,
    )
    raw.extend((path, True, False) for path in cpu_paths)
    for card in sorted((sysfs_root / "class/drm").glob("card*"), key=str):
        if re.fullmatch(r"card\d+", card.name) is None:
            continue
        paths = sorted((card / "device/hwmon").glob("hwmon*/temp*_input"), key=str)
        raw.extend((path, False, True) for path in paths)

    merged: dict[str, SensorCandidate] = {}
    for path, is_cpu, is_gpu in raw:
        resolved = path.resolve()
        key = str(resolved)
        previous = merged.get(key)
        if previous is None:
            merged[key] = SensorCandidate(resolved, path, is_cpu, is_gpu)
        else:
            merged[key] = SensorCandidate(
                previous.path,
                previous.source,
                previous.is_cpu or is_cpu,
                previous.is_gpu or is_gpu,
            )
    return sorted(merged.values(), key=lambda candidate: str(candidate.path))


def _optional_text(path: Path) -> Optional[str]:
    try:
        if not path.is_file():
            return None
        value = path.read_text().strip()
    except (OSError, UnicodeError):
        return None
    return value or None


def _sensor_label(candidate: SensorCandidate) -> str:
    """Derive one stable label without making optional metadata mandatory."""

    match = re.fullmatch(r"temp(\d+)_input", candidate.path.name)
    channel = f"temp{match.group(1)}" if match else candidate.path.name
    name = _optional_text(candidate.path.parent / "name")
    channel_label = (
        _optional_text(candidate.path.parent / f"temp{match.group(1)}_label")
        if match
        else None
    )
    card = _drm_card(candidate.source)
    if name and channel_label:
        return f"{name}:{channel_label}"
    if name:
        return f"{name}:{channel}"
    if card:
        return f"{card}:{channel_label or channel}"
    return str(candidate.path)


def _faulted(candidate: SensorCandidate, label: str) -> Optional[str]:
    """Return a fault diagnostic, or None when the optional flag is clear."""

    match = re.fullmatch(r"temp(\d+)_input", candidate.path.name)
    if match is None:
        return None
    fault_path = candidate.path.parent / f"temp{match.group(1)}_fault"
    try:
        if not fault_path.exists():
            return None
        value = fault_path.read_text().strip().lower()
    except (OSError, UnicodeError) as exc:
        return f"{label}: fault flag unavailable: {exc}"
    if value in {"1", "true", "yes", "on"}:
        return f"{label}: temp{match.group(1)}_fault reports a fault"
    if value not in {"0", "false", "no", "off"}:
        return f"{label}: malformed temp{match.group(1)}_fault value"
    return None


def discover_sensors(sysfs_root: Path = DEFAULT_SYSFS_ROOT) -> SensorSnapshot:
    """Read each deduplicated temperature input once and classify safety."""

    candidates = _sensor_candidates(sysfs_root)
    readings: list[SensorReading] = []
    failures: list[str] = []
    highest: Optional[float] = None
    highest_label: Optional[str] = None
    cpu_valid = False
    off_dgpu_pci, dgpu_state = _switcheroo_state(sysfs_root)
    gpu_present = off_dgpu_pci is not None

    for candidate in candidates:
        label = _sensor_label(candidate)
        gpu_present = gpu_present or candidate.is_gpu
        if off_dgpu_pci is not None and off_dgpu_pci in candidate.path.parts:
            readings.append(
                SensorReading(
                    label,
                    None,
                    candidate.is_cpu,
                    candidate.is_gpu,
                    "dGPU powered off; skipped",
                )
            )
            continue

        try:
            raw_value = candidate.path.read_text().strip()
            raw_millidegrees = int(raw_value)
            value = raw_millidegrees / 1000.0
        except (OSError, ValueError, UnicodeError) as exc:
            value = None
            error = f"{label}: temperature unavailable: {exc}"
        else:
            error = _faulted(candidate, label)
            if error is not None:
                value = None

        if error is not None:
            failures.append(error)
        else:
            if highest is None or value > highest:
                highest = value
                highest_label = label
            if candidate.is_cpu and value > 0:
                cpu_valid = True
        readings.append(
            SensorReading(label, value, candidate.is_cpu, candidate.is_gpu, error)
        )

    if not candidates:
        reason = "no temperature sensors discovered"
    elif not cpu_valid:
        reason = "required CPU temperature is missing, invalid, or unavailable"
    elif failures:
        reason = failures[0]
    elif highest is None:
        reason = "no usable system temperature"
    else:
        reason = "normal sensor input"
    valid = bool(candidates) and cpu_valid and highest is not None and not failures
    return SensorSnapshot(
        tuple(readings),
        highest,
        cpu_valid,
        gpu_present,
        valid,
        reason,
        dgpu_state,
        highest_label,
    )


def _validate_policy(section: str, config: configparser.RawConfigParser) -> FanConfig:
    """Parse and validate one complete fan policy."""

    required = ("low_temp", "high_temp", "speed_curve", "always_full_speed")
    for key in required:
        if not config.has_option(section, key):
            raise ValueError(f"{section}.{key} is missing")
    try:
        low_temp = float(config.get(section, "low_temp"))
    except ValueError as exc:
        raise ValueError(f"{section}.low_temp is malformed") from exc
    try:
        high_temp = float(config.get(section, "high_temp"))
    except ValueError as exc:
        raise ValueError(f"{section}.high_temp is malformed") from exc
    if not math.isfinite(low_temp):
        raise ValueError(f"{section}.low_temp must be finite")
    if not math.isfinite(high_temp):
        raise ValueError(f"{section}.high_temp must be finite")
    if low_temp >= high_temp:
        raise ValueError(f"{section}.low_temp must be lower than high_temp")
    speed_curve = config.get(section, "speed_curve")
    if speed_curve not in CURVES:
        raise ValueError(f"{section}.speed_curve is invalid")
    full_speed = config.get(section, "always_full_speed").strip().lower()
    if full_speed not in {"true", "false"}:
        raise ValueError(f"{section}.always_full_speed must be true or false")
    if speed_curve == "logarithmic" and high_temp - low_temp == 1:
        raise ValueError(f"{section}.speed_curve cannot use a logarithm base of one")
    return FanConfig(low_temp, high_temp, speed_curve, full_speed == "true")


def _default_config(fan_count: int) -> configparser.RawConfigParser:
    config = configparser.RawConfigParser()
    config["General"] = {"control_mode": "smc"}
    for index in range(fan_count):
        config[f"Fan{index + 1}"] = {
            "low_temp": "55",
            "high_temp": "75",
            "speed_curve": "linear",
            "always_full_speed": "false",
        }
    return config


def load_configuration(config_path: Path, fan_count: int) -> ConfigResult:
    """Generate only an absent config, then validate it once for all fans."""

    if not config_path.exists():
        try:
            with config_path.open("w") as config_file:
                _default_config(fan_count).write(config_file)
        except (OSError, UnicodeError) as exc:
            return ConfigResult(
                [None] * fan_count,
                [f"{config_path}: cannot generate config: {exc}"],
                GeneralConfig(None),
                startup_error=True,
            )

    config = configparser.RawConfigParser()
    try:
        with config_path.open() as config_file:
            config.read_file(config_file)
    except (OSError, UnicodeError, configparser.Error) as exc:
        return ConfigResult(
            [None] * fan_count,
            [f"{config_path}: cannot read config: {exc}"],
            GeneralConfig(None),
            startup_error=True,
        )

    errors: list[str] = []
    warnings: list[str] = []
    startup_error = False
    if not config.has_section("General"):
        general = GeneralConfig("t2fand")
        warnings.append("legacy configuration without [General]; using t2fand mode")
    elif not config.has_option("General", "control_mode"):
        general = GeneralConfig(None)
        errors.append("General.control_mode is missing")
        startup_error = True
    else:
        control_mode = config.get("General", "control_mode").strip()
        if control_mode not in {"smc", "t2fand"}:
            general = GeneralConfig(None)
            errors.append("General.control_mode must be smc or t2fand")
            startup_error = True
        else:
            general = GeneralConfig(control_mode)

    policies: list[Optional[FanConfig]] = []
    for index in range(fan_count):
        section = f"Fan{index + 1}"
        if not config.has_section(section):
            errors.append(f"{section} section is missing")
            policies.append(None)
            continue
        try:
            policies.append(_validate_policy(section, config))
        except ValueError as exc:
            errors.append(str(exc))
            policies.append(None)
    if general.control_mode == "smc":
        warnings.extend(errors)
        errors = []
    return ConfigResult(policies, errors, general, warnings, startup_error)


def calculate_target(fan: Fan, policy: FanConfig, temperature: float) -> int:
    """Calculate one clamped target while preserving the three legacy curves."""

    if policy.always_full_speed:
        return fan.maximum if fan.maximum is not None else 0
    if not math.isfinite(temperature):
        raise ValueError("temperature is not finite")
    if temperature <= policy.low_temp:
        target = fan.minimum
    elif temperature >= policy.high_temp:
        target = fan.maximum
    elif policy.speed_curve == "linear":
        target = (
            (temperature - policy.low_temp)
            / (policy.high_temp - policy.low_temp)
            * (fan.maximum - fan.minimum)
            + fan.minimum
        )
    elif policy.speed_curve == "exponential":
        target = (
            (temperature - policy.low_temp) ** 3
            / (policy.high_temp - policy.low_temp) ** 3
            * (fan.maximum - fan.minimum)
            + fan.minimum
        )
    else:
        target = (
            math.log(temperature - policy.low_temp, policy.high_temp - policy.low_temp)
            * (fan.maximum - fan.minimum)
            + fan.minimum
        )
    if target is None or not math.isfinite(float(target)):
        raise ValueError("calculated fan target is not finite")
    return max(fan.minimum, min(fan.maximum, int(target)))


def _set_mode(state: ControllerState, mode: str, reason: str, now: float) -> None:
    changed = state.mode != mode or state.reason != reason
    state.mode = mode
    state.reason = reason
    if changed:
        state.last_problem_at = now
        emit(f"mode transition: mode={mode} reason={reason}")
    elif (
        mode in {"sensor-failsafe", "config-failsafe", "control-error"}
        or state.control_status == "smc-degraded"
    ) and (
        state.last_problem_at is None
        or now - state.last_problem_at >= state.error_reminder_seconds
    ):
        state.last_problem_at = now
        emit(f"warning: mode={mode} reason={reason}")


def _update_gpu_state(
    state: ControllerState, present: bool, dgpu_state: str = "unknown"
) -> None:
    present = present or dgpu_state == "off"
    if state.gpu_present is None:
        state.gpu_present = present
        if not present and dgpu_state != "off":
            emit("warning: gpu-missing")
    elif state.gpu_present != present:
        state.gpu_present = present
        emit("GPU temperatures recovered" if present else "warning: gpu-missing")


def _reset_sensor_recovery(state: ControllerState) -> None:
    state.history.clear()
    state.recovery_history.clear()
    state.recovery_cycles = 0
    state.recovery_active = True


def _maximum_targets(fans: Sequence[Fan]) -> tuple[Optional[int], ...]:
    return tuple(fan.maximum for fan in fans)


def _ownership_failure(
    fans: Sequence[Fan], errors: Sequence[str], state: ControllerState, now: float
) -> None:
    """Escalate an SMC ownership failure without claiming automatic control."""

    detail = "SMC ownership release failed: " + "; ".join(errors)
    maximum_errors = attempt_maximum(fans)
    state.maximum_escalated = True
    if maximum_errors:
        detail += "; maximum escalation failed: " + "; ".join(maximum_errors)
    state.control_status = "control-error"
    _set_mode(state, "control-error", detail, now)
    raise FatalControlError(detail)


def release_smc_ownership(
    fans: Sequence[Fan], state: Optional[ControllerState] = None, now: Optional[float] = None
) -> None:
    """Release and verify every fan, escalating any ownership loss."""

    errors: list[str] = []
    for fan in fans:
        try:
            fan.disable_manual()
            manual = fan.read_manual()
            if manual != 0:
                errors.append(f"{fan.name}: manual state is {manual}, expected 0")
        except (OSError, ValueError, UnicodeError) as exc:
            errors.append(f"{fan.name}: manual release or verification failed: {exc}")
    if errors:
        if state is None:
            maximum_errors = attempt_maximum(fans)
            detail = "SMC ownership release failed: " + "; ".join(errors)
            if maximum_errors:
                detail += "; maximum escalation failed: " + "; ".join(maximum_errors)
            raise FatalControlError(detail)
        _ownership_failure(fans, errors, state, time.monotonic() if now is None else now)


def _maintain_smc_ownership(
    fans: Sequence[Fan], state: ControllerState, now: float
) -> tuple[Optional[int], ...]:
    """Re-read and restore manual ownership state without ordinary output writes."""

    errors: list[str] = []
    observed: list[Optional[int]] = []
    for fan in fans:
        read_error: Optional[str] = None
        try:
            manual = fan.read_manual()
        except (OSError, ValueError, UnicodeError) as exc:
            manual = None
            read_error = str(exc)
        observed.append(manual)
        if manual == 0:
            continue
        if manual == 1:
            emit(f"warning: {fan.name}: unexpected manual=1; restoring SMC ownership", error=True)
        elif read_error is not None:
            emit(
                f"warning: {fan.name}: manual state unavailable: {read_error}; restoring SMC ownership",
                error=True,
            )
        else:
            emit(
                f"warning: {fan.name}: malformed manual state {manual}; restoring SMC ownership",
                error=True,
            )
        try:
            fan.disable_manual()
            if fan.read_manual() != 0:
                errors.append(f"{fan.name}: manual state did not restore to 0")
            else:
                observed[-1] = 0
        except (OSError, ValueError, UnicodeError) as exc:
            errors.append(f"{fan.name}: manual ownership restore failed: {exc}")
    if errors:
        _ownership_failure(fans, errors, state, now)
    return tuple(observed)


def _read_fan_observations(
    fans: Sequence[Fan],
    manual_values: Optional[tuple[Optional[int], ...]] = None,
    actual_values: Optional[tuple[Optional[int], ...]] = None,
) -> tuple[tuple[Optional[int], ...], tuple[Optional[int], ...], tuple[Optional[int], ...], Optional[str]]:
    """Read manual, target, and actual fan values for telemetry."""

    manual: list[Optional[int]] = []
    targets: list[Optional[int]] = []
    actual: list[Optional[int]] = []
    actual_error: Optional[str] = None
    if manual_values is None:
        for fan in fans:
            try:
                manual.append(fan.read_manual())
            except (OSError, ValueError, UnicodeError):
                manual.append(None)
    else:
        manual.extend(manual_values)
    for fan in fans:
        try:
            targets.append(fan.read_target_rpm())
        except (OSError, ValueError, UnicodeError):
            targets.append(None)
    if actual_values is None:
        for fan in fans:
            try:
                actual.append(fan.read_actual_rpm())
            except (OSError, ValueError, UnicodeError) as exc:
                actual.append(None)
                if actual_error is None:
                    actual_error = f"{fan.name}: actual RPM unavailable: {exc}"
    else:
        actual.extend(actual_values)
    return tuple(manual), tuple(targets), tuple(actual), actual_error


def _run_smc_cycle(
    fans: Sequence[Fan],
    state: ControllerState,
    sysfs_root: Path,
    now: float,
) -> CycleReport:
    """Monitor one SMC cycle without taking over fan output."""

    snapshot = discover_sensors(sysfs_root)
    _update_gpu_state(state, snapshot.gpu_present, snapshot.dgpu_state)
    manual_values = _maintain_smc_ownership(fans, state, now)
    manual, targets, actual, actual_error = _read_fan_observations(
        fans, manual_values=manual_values
    )
    state.control_status = (
        "smc-auto" if snapshot.valid and actual_error is None else "smc-degraded"
    )
    reason = "SMC monitoring" if snapshot.valid else snapshot.reason
    _set_mode(state, "smc", reason, now)
    return CycleReport(snapshot, None, targets, actual, manual)


def attempt_maximum(fans: Sequence[Fan]) -> list[str]:
    """Attempt maximum output independently on every known fan."""

    errors: list[str] = []
    for fan in fans:
        if fan.maximum is None:
            errors.append(f"{fan.name}: maximum is unavailable")
            continue
        try:
            fan.set_speed(fan.maximum)
        except (OSError, ValueError, FatalControlError) as exc:
            errors.append(f"{fan.name}: maximum write failed: {exc}")
    if not fans:
        errors.append("no fans available for maximum control")
    return errors


def _require_maximum(fans: Sequence[Fan]) -> None:
    errors = attempt_maximum(fans)
    if errors:
        raise FatalControlError("; ".join(errors))


def run_cycle(
    fans: Sequence[Fan],
    config: ConfigResult,
    state: ControllerState,
    sysfs_root: Path = DEFAULT_SYSFS_ROOT,
    now: Optional[float] = None,
    settings: Optional[RuntimeSettings] = None,
) -> CycleReport:
    """Discover, classify, control, and report one one-second cycle."""

    runtime = settings or RuntimeSettings()
    state.sensor_recovery_cycles = runtime.sensor_recovery_cycles
    state.sample_limit = runtime.sample_limit
    state.error_reminder_seconds = runtime.error_reminder_seconds
    current_time = time.monotonic() if now is None else now
    if config.startup_error:
        raise StartupError(config.errors[0] if config.errors else "configuration startup error")
    if config.control_mode == "smc":
        state.control_mode = "smc"
        return _run_smc_cycle(fans, state, sysfs_root, current_time)
    if config.control_mode not in {"t2fand", None}:
        raise StartupError("invalid control mode")
    state.control_mode = "t2fand"
    snapshot = discover_sensors(sysfs_root)
    _update_gpu_state(state, snapshot.gpu_present, snapshot.dgpu_state)
    rolling_mean: Optional[float] = None

    if state.config_failsafe or not config.valid:
        if not state.config_failsafe:
            state.config_failsafe = True
            state.config_failure_reason = (
                config.errors[0] if config.errors else "invalid fan configuration"
            )
        _set_mode(
            state,
            "config-failsafe",
            state.config_failure_reason or "invalid fan configuration",
            current_time,
        )
        _require_maximum(fans)
        targets = _maximum_targets(fans)
    elif not snapshot.valid:
        _reset_sensor_recovery(state)
        _set_mode(state, "sensor-failsafe", snapshot.reason, current_time)
        _require_maximum(fans)
        targets = _maximum_targets(fans)
    elif state.recovery_active:
        if snapshot.highest is not None:
            state.recovery_history.append(snapshot.highest)
        state.recovery_cycles += 1
        _set_mode(
            state,
            "sensor-failsafe",
            "waiting for valid sensor recovery",
            current_time,
        )
        _require_maximum(fans)
        targets = _maximum_targets(fans)
        if state.recovery_cycles >= state.sensor_recovery_cycles:
            state.history = state.recovery_history[-state.sample_limit:]
            state.recovery_history.clear()
            state.recovery_active = False
    else:
        if snapshot.highest is None:
            raise FatalControlError("valid sensor cycle has no highest temperature")
        state.history.append(snapshot.highest)
        del state.history[:-state.sample_limit]
        control_mean = round(mean(state.history), 2)
        configured_full = any(policy and policy.always_full_speed for policy in config.policies)
        rolling_mean = None if configured_full else control_mean
        mode = "configured-full" if configured_full else "curve"
        reason = "always_full_speed=true" if configured_full else "normal temperature control"
        _set_mode(state, mode, reason, current_time)
        try:
            targets = tuple(
                calculate_target(fan, policy, control_mean)
                for fan, policy in zip(fans, config.policies)
                if policy is not None
            )
        except (ValueError, OverflowError, ZeroDivisionError) as exc:
            state.history.clear()
            state.config_failsafe = True
            state.config_failure_reason = f"unsafe fan policy calculation: {exc}"
            _set_mode(
                state,
                "config-failsafe",
                state.config_failure_reason,
                current_time,
            )
            _require_maximum(fans)
            targets = _maximum_targets(fans)

    if len(targets) != len(fans):
        raise FatalControlError("fan policy count does not match controllable fans")
    actual: list[Optional[int]] = []
    rpm_error: Optional[str] = None
    for fan in fans:
        try:
            actual.append(fan.read_actual_rpm())
        except (OSError, ValueError, UnicodeError) as exc:
            actual.append(None)
            if rpm_error is None:
                rpm_error = f"{fan.name}: actual RPM unavailable: {exc}"
    if rpm_error is not None:
        rolling_mean = None
        targets = _maximum_targets(fans)
        if state.config_failsafe:
            _set_mode(
                state,
                "config-failsafe",
                state.config_failure_reason or "invalid fan configuration",
                current_time,
            )
        else:
            _set_mode(state, "sensor-failsafe", rpm_error, current_time)
        _require_maximum(fans)

    try:
        for fan, target in zip(fans, targets):
            if target is None:
                raise FatalControlError(f"{fan.name}: target is unavailable")
            fan.set_speed(target)
    except (OSError, ValueError, FatalControlError) as exc:
        raise FatalControlError(f"fan target write failed: {exc}") from exc
    manual, observed_targets, observed_actual, _ = _read_fan_observations(
        fans, actual_values=tuple(actual)
    )
    state.control_status = state.mode or ""
    return CycleReport(
        snapshot,
        rolling_mean,
        observed_targets,
        observed_actual,
        manual,
    )


def emit_verbose(
    report: CycleReport,
    fans: Sequence[Fan],
    config: ConfigResult,
    state: ControllerState,
) -> None:
    """Emit one compact complete telemetry record."""

    sensors = ",".join(
        f"{reading.label}="
        f"{reading.value if reading.value is not None else ('skipped' if reading.error == 'dGPU powered off; skipped' else 'unknown')}"
        for reading in report.snapshot.readings
    ) or "none"
    sensor_status = (
        "ok"
        if report.snapshot.valid
        and all(value is not None for value in report.targets)
        and all(value is not None for value in report.actual_rpm)
        else "degraded"
    )
    fields = [
        f"control_mode={config.control_mode}",
        f"control_status={state.control_status or state.mode}",
        f"sensor_status={sensor_status}",
        f"sensors={sensors}",
        f"gpu_temps={'present' if report.snapshot.gpu_present else 'missing'}",
        f"dgpu_state={report.snapshot.dgpu_state}",
        f"highest={report.snapshot.highest_label or 'unknown'}",
        f"highest_temp={report.snapshot.highest if report.snapshot.highest is not None else 'unknown'}",
    ]
    if config.control_mode == "t2fand" and report.rolling_mean is not None:
        fields.append(f"rolling_mean={report.rolling_mean}")
    fields.extend([f"mode={state.mode}", f"status={state.mode}", f"reason={state.reason}"])
    if state.recovery_active:
        fields.append(
            f"recovery_cycles={state.recovery_cycles}/{state.sensor_recovery_cycles}"
        )
    for index, (fan, target, actual, manual) in enumerate(
        zip(fans, report.targets, report.actual_rpm, report.manual or (None,) * len(fans)),
        start=1,
    ):
        policy = config.policies[index - 1] if index <= len(config.policies) else None
        policy_fields = ""
        if config.control_mode == "t2fand":
            if policy is None:
                policy_fields = "low_temp=unknown high_temp=unknown curve=unknown always_full_speed=unknown "
            else:
                policy_fields = (
                    f"low_temp={policy.low_temp} high_temp={policy.high_temp} "
                    f"curve={policy.speed_curve} always_full_speed={str(policy.always_full_speed).lower()} "
                )
        fields.append(
            f"fan{index} {policy_fields}manual={manual if manual is not None else 'unknown'} "
            f"target_rpm={target if target is not None else 'unknown'} "
            f"actual_rpm={actual if actual is not None else 'unknown'}"
        )
    emit("telemetry " + " ".join(fields))


def emit_compact(report: CycleReport, fans: Sequence[Fan]) -> None:
    """Emit the hottest sensor and actual fan speeds for one cycle."""

    fields = [
        f"highest={report.snapshot.highest_label or 'unknown'}",
        f"highest_temp={report.snapshot.highest if report.snapshot.highest is not None else 'unknown'}",
    ]
    fields.extend(
        f"{fan.name} actual_rpm={actual if actual is not None else 'unknown'}"
        for fan, actual in zip(fans, report.actual_rpm)
    )
    emit("telemetry " + " ".join(fields))


def install_signal_handlers(state: ControllerState) -> None:
    """Install handlers that only request the common shutdown route."""

    def request_shutdown(signum: int, frame: object) -> None:
        del signum, frame
        state.shutdown_requested = True

    signal.signal(signal.SIGINT, request_shutdown)
    signal.signal(signal.SIGTERM, request_shutdown)


def run_loop(
    fans: Sequence[Fan],
    config: ConfigResult,
    state: ControllerState,
    sysfs_root: Path = DEFAULT_SYSFS_ROOT,
    verbose: bool = False,
    sleeper: Callable[[float], None] = time.sleep,
    clock: Callable[[], float] = time.monotonic,
    settings: Optional[RuntimeSettings] = None,
) -> None:
    """Run one-second cycles until a signal handler requests shutdown."""

    while not state.shutdown_requested:
        report = run_cycle(
            fans, config, state, sysfs_root, clock(), settings=settings
        )
        if verbose:
            emit_verbose(report, fans, config, state)
        else:
            emit_compact(report, fans)
        if not state.shutdown_requested:
            sleeper(1)
    _set_mode(state, "shutting-down", "shutdown requested", clock())


def prepare_pid(pid_path: Path, proc_root: Path = Path("/proc")) -> None:
    """Reject live PID ownership and remove malformed or stale PID files."""

    if not pid_path.exists():
        return
    try:
        text = pid_path.read_text().strip()
        pid = int(text)
        if pid <= 0:
            raise ValueError("PID must be positive")
    except (OSError, ValueError, UnicodeError) as exc:
        emit(
            f"warning: malformed PID file {pid_path}: {exc}; removing stale file",
            error=True,
        )
        try:
            pid_path.unlink()
        except OSError as unlink_error:
            raise StartupError(
                f"cannot remove malformed PID file {pid_path}: {unlink_error}"
            ) from unlink_error
        return
    if (proc_root / str(pid)).exists():
        raise StartupError(f"T2 Fan Daemon is already running (PID {pid})")
    emit(f"warning: removing stale PID file {pid_path}", error=True)
    try:
        pid_path.unlink()
    except OSError as exc:
        raise StartupError(f"cannot remove stale PID file {pid_path}: {exc}") from exc


def write_pid(pid_path: Path, pid: Optional[int] = None) -> None:
    """Write the daemon-owned decimal PID file."""

    try:
        pid_path.write_text(str(os.getpid() if pid is None else pid))
    except (OSError, UnicodeError) as exc:
        raise StartupError(f"cannot write PID file {pid_path}: {exc}") from exc


def remove_pid(pid_path: Path) -> Optional[str]:
    """Attempt PID removal and return a diagnostic instead of raising."""

    try:
        pid_path.unlink(missing_ok=True)
    except OSError as exc:
        return f"PID cleanup failed: {exc}"
    return None


def cleanup_fans(fans: Sequence[Fan]) -> list[str]:
    """Disable manual mode independently for every fan."""

    errors: list[str] = []
    for fan in fans:
        try:
            fan.disable_manual()
        except (OSError, ValueError) as exc:
            errors.append(f"{fan.name}: manual-mode cleanup failed: {exc}")
    return errors


def _positive_int(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a positive integer") from exc
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def _positive_float(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a positive finite float") from exc
    if not math.isfinite(parsed) or parsed <= 0:
        raise argparse.ArgumentTypeError("must be a positive finite float")
    return parsed


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="T2 fan thermal controller",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="emit full telemetry"
    )
    parser.add_argument("-V", "--version", action="version", version="2.0.0-dev")
    parser.add_argument(
        "-c",
        "--config-path",
        type=Path,
        default=DEFAULT_CONFIG_PATH,
        help="configuration file path",
    )
    parser.add_argument(
        "-p",
        "--pid-path",
        type=Path,
        default=DEFAULT_PID_PATH,
        help="PID file path",
    )
    parser.add_argument(
        "-s",
        "--sysfs-path",
        type=Path,
        default=DEFAULT_SYSFS_ROOT,
        help="sysfs root path",
    )
    parser.add_argument(
        "-r",
        "--sensor-recovery-cycles",
        type=_positive_int,
        default=SENSOR_RECOVERY_CYCLES,
        help="valid cycles before sensor recovery",
    )
    parser.add_argument(
        "-l",
        "--sample-limit",
        type=_positive_int,
        default=SAMPLE_LIMIT,
        help="maximum temperature samples",
    )
    parser.add_argument(
        "-e",
        "--error-reminder-seconds",
        type=_positive_float,
        default=ERROR_REMINDER_SECONDS,
        help="minimum seconds between repeated error reminders",
    )
    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    """Validate startup state, run the foreground controller, and clean up."""

    args = _parser().parse_args(argv)
    runtime_settings = RuntimeSettings(
        args.sensor_recovery_cycles,
        args.sample_limit,
        args.error_reminder_seconds,
    )
    if os.geteuid() != 0:
        emit("T2 Fan Daemon must be run as root", error=True)
        return 1

    fans: list[Fan] = []
    state = ControllerState(
        sensor_recovery_cycles=runtime_settings.sensor_recovery_cycles,
        sample_limit=runtime_settings.sample_limit,
        error_reminder_seconds=runtime_settings.error_reminder_seconds,
    )
    pid_owned = False
    manual_attempted = False
    ownership_attempted = False
    maximum_cleanup_required = False
    control_started = False
    fatal: Optional[str] = None
    try:
        prepare_pid(args.pid_path)
        fans, fan_errors = discover_fans(args.sysfs_path)
        if fan_errors:
            maximum_cleanup_required = True
            raise FatalControlError("; ".join(fan_errors))
        config = load_configuration(args.config_path, len(fans))
        emit(f"T2 Fan Daemon starting: fans={len(fans)}")
        if config.startup_error or config.control_mode not in {"smc", "t2fand"}:
            raise StartupError(config.errors[0] if config.errors else "invalid control mode")
        for warning in config.warnings:
            emit(f"configuration warning: {warning}", error=True)
        for problem in config.errors:
            emit(f"configuration error: {problem}", error=True)
        state.control_mode = config.control_mode
        install_signal_handlers(state)
        write_pid(args.pid_path)
        pid_owned = True
        if config.control_mode == "smc":
            ownership_attempted = True
            release_smc_ownership(fans, state)
        else:
            manual_attempted = True
            for fan in fans:
                try:
                    fan.enable_manual()
                except (OSError, ValueError) as exc:
                    raise FatalControlError(f"{fan.name}: cannot enable manual mode: {exc}") from exc
            if not config.valid:
                maximum_cleanup_required = True
                _set_mode(state, "config-failsafe", config.errors[0], time.monotonic())
                _require_maximum(fans)
        control_started = True
        run_loop(
            fans,
            config,
            state,
            sysfs_root=args.sysfs_path,
            verbose=args.verbose,
            settings=runtime_settings,
        )
    except (StartupError, FatalControlError) as exc:
        fatal = str(exc)
    except Exception as exc:
        if not control_started or isinstance(exc, DaemonError):
            raise
        fatal = str(exc)
    finally:
        if fatal is not None:
            _set_mode(state, "control-error", fatal, time.monotonic())
            emit(f"critical: {fatal}", error=True)
            if (
                (maximum_cleanup_required or manual_attempted or ownership_attempted)
                and not state.maximum_escalated
            ):
                for problem in attempt_maximum(fans):
                    emit(f"cleanup error: {problem}", error=True)
        if manual_attempted or ownership_attempted:
            cleanup_errors = cleanup_fans(fans)
            for problem in cleanup_errors:
                emit(f"cleanup error: {problem}", error=True)
            if (
                fatal is None
                and config.control_mode == "smc"
                and cleanup_errors
            ):
                fatal = "SMC ownership release failed during shutdown: " + "; ".join(
                    cleanup_errors
                )
                _set_mode(state, "control-error", fatal, time.monotonic())
                emit(f"critical: {fatal}", error=True)
                for problem in attempt_maximum(fans):
                    emit(f"cleanup error: {problem}", error=True)
        if pid_owned:
            problem = remove_pid(args.pid_path)
            if problem is not None:
                emit(f"cleanup error: {problem}", error=True)
        if fatal is None and control_started:
            emit("T2 Fan Daemon stopped: shutdown cleanup complete")
    return 1 if fatal is not None else 0


if __name__ == "__main__":
    raise SystemExit(main())
