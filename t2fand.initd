#!/sbin/openrc-run

description="A simple daemon to control fan speed on Macs with T2 chip"
command=/usr/bin/t2fand
command_args="${t2fand_args:-}"
supervisor="supervise-daemon"
# Keep the daemon foregrounded; its PID file is separate from supervisor state.
# Use a two-second base delay between eligible respawns.
respawn_delay="2"
# Bound crash loops to five respawns per 60-second window.
respawn_max="5"
respawn_period="60"
# Increase the respawn delay by two seconds after each crash.
supervise_daemon_args="--respawn-delay-step 2"
# Send SIGTERM on stop and wait up to five seconds.
retry="SIGTERM/5"
# Send application stdout/stderr to the administrator-selected logger.
output_logger="/usr/bin/logger -t t2fand -p daemon.info"
error_logger="/usr/bin/logger -t t2fand -p daemon.err"

# Require local filesystems; logger remains an optional dependency.
depend() {
	need localmount
	use logger
}
